# Скопируйте в .env и подставьте реальный токен от @BotFather
BOT_TOKEN=your_token_from_botfather

# Куда приходят уведомления (обязательно). Число (личный чат/группа),
# @username канала или chat_id:thread_id (топик форума/супергруппы);
# можно несколько через запятую. Как узнать: напишите боту любое
# сообщение и запустите python scripts/get_chat_id.py
NOTIFY_CHAT_ID=

# Прокси для Telegram API — нужен, если api.telegram.org недоступен
# (в Беларуси Telegram блокируется). Пример: socks5h://127.0.0.1:1080
# HTTPS_PROXY=
